{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://claimwright.local/schemas/similarity-candidate-report.schema.json",
  "type":"object",
  "required":["schema_version","artifact_sha256","method","tool_version","corpus","corpus_limitations","candidates"],
  "properties":{
    "schema_version":{"const":"claimwright.similarity_candidate_report.v1"},
    "artifact_sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "method":{"type":"string","minLength":1},"tool_version":{"type":"string","minLength":1},
    "corpus":{"type":"string","minLength":1},
    "corpus_limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "candidates":{"type":"array","items":{"type":"object","required":["source_id","artifact_location","overlap_kind","materiality","disposition"],"properties":{"source_id":{"type":"string","minLength":1},"artifact_location":{"type":"string","minLength":1},"source_location":{"type":"string"},"overlap_kind":{"enum":["exact","near_exact","paraphrase_candidate","self_overlap","cross_language_candidate"]},"score":{"type":"number"},"score_semantics":{"type":"string"},"excerpt":{"type":"string","maxLength":1000},"excerpt_hash":{"type":"string"},"materiality":{"enum":["material","not_material","unknown"]},"disposition":{"type":"string","minLength":1},"disposition_rationale":{"type":"string"}},"additionalProperties":false}}
  },"additionalProperties":false
}
